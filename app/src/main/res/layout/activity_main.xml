<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F5FB"
    android:fitsSystemWindows="true"
    tools:context=".MainActivity">

    <!-- Header -->
    <RelativeLayout
        android:id="@+id/headerMain"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#6C63FF"
        android:padding="24dp">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:text="HabitFlow"
            android:textColor="#FFFFFF"
            android:textSize="34sp" />

        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/tvTitle"
            android:layout_marginTop="4dp"
            android:fontFamily="sans-serif-light"
            android:text="Build better habits, one day at a time"
            android:textColor="#E0DEFF"
            android:textSize="15sp" />
    </RelativeLayout>

    <!-- Bottom buttons -->
    <LinearLayout
        android:id="@+id/layoutButtons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="#FFFFFF"
        android:elevation="8dp"
        android:orientation="horizontal"
        android:padding="12dp">

        <Button
            android:id="@+id/btnAdd"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:backgroundTint="#6C63FF"
            android:fontFamily="sans-serif-medium"
            android:text="+ Add Habit"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            app:cornerRadius="16dp" />

        <Button
            android:id="@+id/btnSummary"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:backgroundTint="#4A3FD1"
            android:fontFamily="sans-serif-medium"
            android:text="Summary"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            app:cornerRadius="16dp" />
    </LinearLayout>

    <!-- Empty message -->
    <TextView
        android:id="@+id/tvEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/headerMain"
        android:layout_marginTop="60dp"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:text="No habits yet.\nTap Add Habit to start."
        android:textColor="#6B7280"
        android:textSize="17sp"
        android:visibility="gone" />

    <!-- Habit list -->
    <ListView
        android:id="@+id/listHabits"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/layoutButtons"
        android:layout_below="@id/headerMain"
        android:clipToPadding="false"
        android:divider="@android:color/transparent"
        android:dividerHeight="0dp"
        android:padding="10dp"
        android:scrollbars="none" />
</RelativeLayout>