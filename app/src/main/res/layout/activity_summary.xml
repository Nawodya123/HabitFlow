<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F5FB"
    android:fitsSystemWindows="true">

    <!-- Header -->
    <RelativeLayout
        android:id="@+id/headerSummary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#6C63FF"
        android:padding="24dp">

        <TextView
            android:id="@+id/tvSummaryTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:text="Summary"
            android:textColor="#FFFFFF"
            android:textSize="32sp" />

        <TextView
            android:id="@+id/tvSummarySubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/tvSummaryTitle"
            android:layout_marginTop="4dp"
            android:fontFamily="sans-serif-light"
            android:text="Your progress at a glance"
            android:textColor="#E0DEFF"
            android:textSize="15sp" />
    </RelativeLayout>

    <!-- Bottom Back bar -->
    <RelativeLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="#FFFFFF"
        android:elevation="8dp"
        android:padding="12dp">

        <Button
            android:id="@+id/btnBack"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:backgroundTint="#6C63FF"
            android:fontFamily="sans-serif-medium"
            android:text="Back"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            app:cornerRadius="16dp" />
    </RelativeLayout>

    <!-- Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottomBar"
        android:layout_below="@id/headerSummary"
        android:clipToPadding="false"
        android:padding="16dp"
        android:scrollbars="none">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Card 1: Overall progress -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardOverall"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="20dp">

                    <TextView
                        android:id="@+id/tvOverallTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.15"
                        android:text="OVERALL PROGRESS"
                        android:textColor="#6C63FF"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvOverall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/tvOverallTitle"
                        android:layout_marginTop="10dp"
                        android:fontFamily="sans-serif-black"
                        android:textColor="#1F2937"
                        android:textSize="22sp" />

                    <ProgressBar
                        android:id="@+id/pbOverall"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="12dp"
                        android:layout_below="@id/tvOverall"
                        android:layout_marginTop="14dp"
                        android:max="100"
                        android:progressBackgroundTint="#E5E7EB"
                        android:progressTint="#10B981" />
                </RelativeLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card 2: Stats -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardStats"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/cardOverall"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="20dp">

                    <TextView
                        android:id="@+id/tvStatsTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.15"
                        android:text="STATS"
                        android:textColor="#6C63FF"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvTotal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/tvStatsTitle"
                        android:layout_marginTop="12dp"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="#1F2937"
                        android:textSize="18sp" />

                    <View
                        android:id="@+id/divider1"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_below="@id/tvTotal"
                        android:layout_marginTop="12dp"
                        android:background="#E5E7EB" />

                    <TextView
                        android:id="@+id/tvCompleted"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/divider1"
                        android:layout_marginTop="12dp"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="#1F2937"
                        android:textSize="18sp" />

                    <View
                        android:id="@+id/divider2"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_below="@id/tvCompleted"
                        android:layout_marginTop="12dp"
                        android:background="#E5E7EB" />

                    <TextView
                        android:id="@+id/tvBest"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/divider2"
                        android:layout_marginTop="12dp"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="#1F2937"
                        android:textSize="18sp" />
                </RelativeLayout>
            </com.google.android.material.card.MaterialCardView>
        </RelativeLayout>
    </ScrollView>
</RelativeLayout>